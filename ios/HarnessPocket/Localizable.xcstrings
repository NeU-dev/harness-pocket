    "値" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Value" } } } },
    "入力中の文章が見えるか確認します。\n複数行のメッセージでも\nキーボードの上に入力欄が収まり\n最後の行まで確認できます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check that the text being entered is visible.\nEven with a multi-line message,\nthe composer stays above the keyboard\nso you can see the final line." } } } },
