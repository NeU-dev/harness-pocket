    "Apple通知エラー: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple notification error: %@" } } } },
    "Apple通知キー（初回のみ）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple push key (first-time setup)" } } } },
    "Chat Completions互換" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Chat Completions compatible" } } } },
    "DGXからiPhoneへ通知するための設定です。Apple DeveloperでAPNsキーを作成し、ここからDGXへ登録します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This lets your DGX send notifications to your iPhone. Create an APNs key in Apple Developer, then save it to your DGX here." } } } },
    "DGXでDSHを起動した時の「dsh web:」に続くURLを貼り付けてください（http://127.0.0.1:…/?token=…）。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste the URL shown after “dsh web:” when you start DSH on your DGX (http://127.0.0.1:…/?token=…)." } } } },
    "DGXで処理中…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Working on DGX…" } } } },
    "DGXで発行したコード" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Code generated on your DGX" } } } },
    "DGXと接続する" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to DGX" } } } },
    "DGXに登録された権限プリセットです。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A permission preset provided by your DGX." } } } },
    "DGXのHarnessに接続できません" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not connect to Harness on your DGX" } } } },
    "DGXのフォルダ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DGX folders" } } } },
    "DGXのフォルダから選ぶ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose from DGX folders" } } } },
    "DGXのフォルダを読み込み中…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading DGX folders…" } } } },
    "DGXのホーム" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DGX home" } } } },
    "DGXの中継に届いていません。TailscaleとDGXの起動状態を確認してください。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The DGX gateway is unreachable. Check Tailscale and make sure your DGX is running." } } } },
    "DGXの権限設定を読み込んでいます" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading permissions from your DGX" } } } },
    "DGXへ保存しました" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved to DGX" } } } },
    "DGXへ再接続中 · 接続を確認" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnecting to DGX · Check connection" } } } },
    "DGXへ接続してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to your DGX" } } } },
    "DGX上のファイルへ広くアクセスし、承認の確認を省略します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allows broad access to files on your DGX and skips approval prompts." } } } },
    "DGX上のフォルダ（/home/…）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folder on DGX (/home/…)" } } } },
    "DSHとの自動連携が有効です。「再接続」を試してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic DSH integration is enabled. Try reconnecting" } } } },
    "DSHに接続しています" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected to DSH" } } } },
    "DSHの接続先はDGX内のlocalhostを指定してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use a localhost address on the DGX for DSH" } } } },
    "DSHの起動時URL" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DSH startup URL" } } } },
    "DSHの起動時URLにtokenが必要です" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The DSH startup URL must include a token" } } } },
    "DSHの起動時URLを指定してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the DSH startup URL" } } } },
    "DSHの起動時URLを確認してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check the DSH startup URL" } } } },
    "DSHの認証を更新できません。接続設定で起動時URLを更新してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not refresh DSH authentication. Update the startup URL in Connection Settings" } } } },
    "DSHへの接続を確認してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check the DSH connection" } } } },
    "DSHを再起動すると、最新の接続情報を自動で読み直します。少し待ってもつながらない時は「再接続する」を試してください。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After DSH restarts, the latest connection details load automatically. If it does not reconnect after a moment, tap Reconnect." } } } },
    "DSHを起動してから「再接続する」を試してください。起動時URLが変わった時は、下の入力欄から更新できます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start DSH, then tap Reconnect. If the startup URL changed, update it below." } } } },
    "Harness Pocket 0.1\n会話・モデル実行・設定の保存はDGX側で行います。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Harness Pocket 0.1\nConversations, model execution, and settings are stored on your DGX." } } } },
    "Harness Pocket · あなたのDGXとつながる" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Harness Pocket · Connected to your DGX" } } } },
    "Harness Pocketの登録QRコードを読み取ってください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan a Harness Pocket pairing QR code" } } } },
    "Harness Pocket用の接続先ではありません" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This is not a Harness Pocket endpoint" } } } },
    "Harnessの会話履歴は保持されます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The conversation remains in Harness." } } } },
    "Harnessの設定" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Harness settings" } } } },
    "Harnessの起動時トークンが必要です" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Harness startup token is required" } } } },
    "Harnessの認証期限が切れました。再接続してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Harness authentication expired. Reconnect to continue" } } } },
    "Harnessへ接続中です" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connecting to Harness" } } } },
    "Harness応答形式が対応バージョンと異なります" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Harness response format is from an unsupported version" } } } },
    "JSONが不正です" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Invalid JSON" } } } },
    "Key ID と Team ID は10文字の英数字です" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Key ID and Team ID must each be 10 alphanumeric characters" } } } },
    "POCKET_NOTIFICATION_APPROVAL" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Harness Pocket needs permission for an operation. Tap to allow or deny it." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "操作の許可を待っています。タップして許可・拒否を選んでください。" } } } },
    "POCKET_NOTIFICATION_COMPLETE" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your response is ready. Tap to continue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "回答が完了しました。タップして続きを確認できます。" } } } },
    "POCKET_NOTIFICATION_QUESTION" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Harness Pocket has a question for you. Tap to answer." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "あなたへの質問があります。タップして回答してください。" } } } },
    "POCKET_NOTIFICATION_TEST" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The notification connection test completed." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "通知の接続テストが完了しました。" } } } },
    "QRコードを読み取る" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan QR code" } } } },
    "Responses互換" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Responses compatible" } } } },
    "Web検索" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Web search" } } } },
    "\n下書きに戻しました。モデルや添付を変更して送信できます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "\nReturned to your draft. Change the model or attachments and send again." } } } },
    "https:// から始まるアプリ用接続先を入力してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter an app endpoint that starts with https://" } } } },
    "iPhoneの「設定 → 通知 → Harness Pocket」で通知を許可してください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow notifications in iPhone Settings → Notifications → Harness Pocket" } } } },
    "あなたのDGXを、\nもっと身近に。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your DGX,\ncloser than ever." } } } },
    "いつものAIを、\nポケットに。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your AI,\nin your pocket." } } } },
    "いつものAIを、ポケットに。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your AI, in your pocket." } } } },
    "このURLで接続する" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect with this URL" } } } },
    "このiPhone" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This iPhone" } } } },
    "このiPhoneの接続を解除しますか？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect this iPhone?" } } } },
    "このiPhoneの登録を解除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unpair this iPhone" } } } },
    "このiPhoneの通知を有効にしてください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable notifications on this iPhone" } } } },
    "このiPhoneを登録しました" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This iPhone is registered" } } } },
    "このフォルダを使う" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use this folder" } } } },
    "この会話" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation" } } } },
    "この会話の権限" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permissions for this conversation" } } } },
    "この会話の次のリクエストから適用します。全体の既定値は設定画面で変更できます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Applies to the next request in this conversation. Change the global default in Settings." } } } },
    "この参照名のキーを削除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete key with this reference" } } } },
    "この場所を登録し、新しい会話の作業場所に設定します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Register this folder and use it as the workspace for new conversations." } } } },
    "この承認要求は終了しました。会話を再読み込みしてください" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This approval request has ended. Reload the conversation" } } } },
    "この端末" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device" } } } },
    "この端末の接続を解除しますか？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect this device?" } } } },
    "この設定はHarness再起動後に反映されます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This setting takes effect after Harness restarts." } } } },
    "この階層のフォルダを検索" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search folders at this level" } } } },
    "すべて許可（確認なし）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Full access (no confirmation)" } } } },
    "どちらから進めましょう？" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Which should we start with?" } } } },
    "はい。自宅のDGX Sparkにつないで、ここから会話を続けられます。\n\n**画面を閉じても大丈夫。**\n回答が完了すると、iPhoneに通知が届きます。\n\nモデルの切り替えや基本設定も、右上の設定から操作できます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Yes. Connect to your DGX Spark at home and continue the conversation from here.\n\n**You can close the app.**\nYour iPhone will notify you when the response is ready.\n\nYou can also change the model and basic settings from the top-right button." } } } },
    "もう一度読み込む" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Load again" } } } },
    "アーカイブ" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Archive" } } } },
