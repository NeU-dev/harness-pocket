# Loopback only. Put Tailscale Serve HTTPS in front of this port.
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=https://YOUR-SPARK.YOUR-TAILNET.ts.net:8443
DSH_URL=http://127.0.0.1:3080
# Startup token printed by dsh web. Never commit the actual token.
DSH_TOKEN=
DATA_DIR=../data
# Obtain at developer.apple.com/account/resources/authkeys/list
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Must match your own iOS Bundle Identifier. The app can also save it with the key.
APNS_TOPIC=com.example.HarnessPocket
